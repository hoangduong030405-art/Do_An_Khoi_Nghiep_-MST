{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Chạy HUEGO Backend (NestJS)",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
      "program": "${workspaceFolder}/backend/dist/main.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug HUEGO Backend (TypeScript ts-node)",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
      "args": ["${workspaceFolder}/backend/src/main.ts"],
      "runtimeArgs": ["-r", "ts-node/register"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "sourceMaps": true,
      "protocol": "inspector"
    },
    {
      "name": "Run HUEGO Mobile (Flutter)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile"
    }
  ]
}
